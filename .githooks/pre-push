#!/bin/sh

# Allow only explicit, same-name, fast-forward codex/* updates to the two project remotes.
remote_name=${1-}
remote_url=${2-}
host_url=https://miaoda-git.feishu.cn/apaas4.0/-/t_mx8LiKO6/code_T0OCUEHo3all.git
github_url=https://github.com/Liu-Xuan/WiseLink_Host.git

reject() {
  printf '%s\n' 'Push blocked: only one fast-forward same-name refs/heads/codex/* update to the configured origin or github URL is allowed.' >&2
  exit 1
}

if [ "$remote_name" = origin ]; then
  [ "$remote_url" = "$host_url" ] || reject
elif [ "$remote_name" = github ]; then
  [ "$remote_url" = "$github_url" ] || reject
else
  reject
fi

IFS= read -r update || reject
if IFS= read -r extra_update; then
  reject
fi

set -- $update
[ "$#" -eq 4 ] || reject
local_ref=$1
local_sha=$2
remote_ref=$3
remote_sha=$4

case "$local_ref" in
  refs/heads/codex/*) ;;
  *) reject ;;
esac
[ "$local_ref" = "$remote_ref" ] || reject
case "$local_sha" in
  ''|*[!0123456789abcdefABCDEF]*) reject ;;
esac
[ "${#local_sha}" -eq 40 ] || reject
case "$remote_sha" in
  ''|*[!0123456789abcdefABCDEF]*) reject ;;
esac
[ "${#remote_sha}" -eq 40 ] || reject
[ "$local_sha" != 0000000000000000000000000000000000000000 ] || reject

if [ "$remote_sha" != 0000000000000000000000000000000000000000 ]; then
  git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || reject
fi

exit 0
