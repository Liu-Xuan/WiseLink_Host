{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "jest"],
    "paths": {
      "@client/*": ["client/*"],
      "@server/*": ["server/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["server/**/*", "shared/**/*.ts", "test/unit/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "client",
    "source_package",
    "**/*.e2e-spec.ts"
  ]
}
