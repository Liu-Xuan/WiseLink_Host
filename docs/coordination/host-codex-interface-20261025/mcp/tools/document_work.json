          "sectionIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "candidateSchemaVersion": {
            "type": "string",
            "enum": [
              "wiselink.document.activity-candidate.v1",
              "wiselink.document.activity-candidate.v2"
            ]
