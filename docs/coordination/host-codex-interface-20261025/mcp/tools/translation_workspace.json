          },
          "leaseGeneration": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "phase": {
            "type": "string",
            "const": "READ"
          }
        },
        "required": [
          "attemptRef",
          "leaseToken",
          "leaseGeneration",
          "phase"
        ],
        "additionalProperties": false
      },
