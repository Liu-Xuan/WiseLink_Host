{
  "name": "record_assessment_consumer_stopped",
  "title": "记录当前评估执行已停止",
  "description": "仅记录当前fenced执行已停止且上游结果UNKNOWN的安全元数据；精确请求绑定及幂等。不更改attempt终态、期限、租约、保存工作或队列。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "attemptRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "workItemId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "leaseToken": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "leaseGeneration": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "requestId": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "documentVersionId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
      },
      "inputRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "modelRound": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64
      },
      "errorCode": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_:.-]{0,199}$"
      },
      "upstreamOutcome": {
        "type": "string",
        "const": "UNKNOWN"
      }
    },
    "required": [
      "attemptRef",
      "workItemId",
      "leaseToken",
      "leaseGeneration",
      "requestId",
      "documentVersionId",
      "inputRevision",
      "modelRound",
      "errorCode",
      "upstreamOutcome"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
