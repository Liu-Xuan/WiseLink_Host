{
  "name": "read_document_original",
  "title": "读取确切版本原文",
  "description": "按documentVersionId和parseRunId重新校验来源授权，返回有界完整原文单元、真实定位和覆盖限制。提供compareWith、semanticRevision和roleKey时读取同family两版说明及所选文本比较；该模式不接受分页或sectionId。读取不代表已评估全文、版本相邻或正式采用。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "documentVersionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "deliveryRef": {
        "type": "string",
        "pattern": "^(?:work-item:WI(?:-[A-Za-z0-9_-]{1,93})?|acquisition:[A-Za-z0-9_-]{1,96})$"
      },
      "parseRunId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "semanticRevision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "sectionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "compareWith": {
        "type": "object",
        "properties": {
          "documentVersionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "parseRunId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "semanticRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "documentVersionId",
          "parseRunId",
          "semanticRevision"
        ],
        "additionalProperties": false
      },
      "roleKey": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,120}$"
      }
    },
    "required": [
      "documentVersionId",
      "parseRunId"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  }
}
