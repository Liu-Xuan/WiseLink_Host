{
  "name": "record_oem_discovery_run",
  "title": "记录 OEM 公开网站发现结果",
  "description": "可选后台工具：仅在整体综合明确指出需补充某一 OEM 调查时，记录该次公开网站 discovery 到妙搭 SearchRun/候选表；时间、租户、actor 和 SearchRun 身份均由服务端派生，不采纳文档或触发 DM。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workItemId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "result": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "BOEING",
              "AIRBUS",
              "COMAC"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "resultStatus": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "ACCESS_DENIED",
              "ZERO_RESULT",
              "ZERO_RESULTS_FOR_TARGET_IDENTIFIER",
              "TRUNCATED"
            ]
          },
          "candidates": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "sourceUrl": {
                  "type": "string",
                  "maxLength": 4000,
                  "format": "uri"
                },
                "documentNumber": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revisionLabel": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "snippet": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "relationshipReason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "matchLevel": {
                  "type": "string",
                  "enum": [
                    "DIRECT",
                    "TANGENTIAL"
                  ]
                }
              },
              "required": [
                "title",
                "sourceUrl",
                "documentNumber",
                "revisionLabel",
                "snippet",
                "relationshipReason",
                "matchLevel"
              ],
              "additionalProperties": false
            }
          },
          "accessRestricted": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "partialOnly": {
            "type": "boolean"
          },
          "excludedNonOemCandidateCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "query",
          "resultStatus",
          "candidates",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "workItemId",
      "result"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
