{
  "name": "save_assessment_work",
  "title": "保存 JobAid 问题工作正文",
  "description": "保存完整问题修订和实际依据，原 request 精确幂等及工作 revision CAS；不改变正式采用、WorkItem current 或已取消 attempt。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "attemptRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "workItemId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "leaseToken": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "leaseGeneration": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "requestId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9:_-]{1,96}$"
      },
      "expectedWorkRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "workJson": {
        "type": "string",
        "minLength": 2,
        "maxLength": 1000000
      }
    },
    "required": [
      "attemptRef",
      "leaseToken",
      "leaseGeneration",
      "requestId",
      "expectedWorkRevision",
      "workJson"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
