  "inputSchema": {
    "type": "object",
    "properties": {
      "workItemId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "successorReviewTurnRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "required": [
      "workItemId"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
