{
  "paths": {
    "/openapi/wiselink/development-work-items": {
      "post": {
        "operationId": "createDevelopmentWorkItem",
        "summary": "受控创建 S1 开发验收 WorkItem",
        "description": "仅供受控开发验收编排调用，不是生产前端功能。服务端从受信请求上下文取得租户，并固定使用 S1 验收服务身份；请求体不得携带 actor、roles、authority 或其他权限字段。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["documentVersionId", "developmentRunToken"],
                "properties": {
                  "documentVersionId": {
                    "type": "string",
                    "description": "要运行的精确且当前的 DocumentVersion ID",
                    "example": "document_version_f4813607b91ee1a20e754e2d"
                  },
                  "developmentRunToken": {
                    "type": "string",
                    "format": "uuid",
                    "description": "本次开发验收运行的一次性幂等 UUID",
                    "example": "0f8fad5b-d9cb-469f-a165-70867728950e"
                  },
                  "query": {
                    "type": "string",
                    "description": "Reader 查询词，省略时由服务端使用默认查询",
                    "example": "applicability"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建或幂等复用开发验收 WorkItem，并返回首个解析 ActionAttempt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["schemaVersion", "workItemCreated", "workItemReused", "actionAttemptId", "result"],
                  "properties": {
                    "schemaVersion": {
                      "type": "string",
                      "description": "运行响应合同版本",
                      "example": "wiselink.3_1.ordinary_work_item_run.v1"
                    },
                    "workItemCreated": {
                      "type": "boolean",
                      "description": "本次是否新建 WorkItem",
                      "example": true
                    },
                    "workItemReused": {
                      "type": "boolean",
                      "description": "本次是否按幂等键复用既有 WorkItem",
                      "example": false
                    },
                    "actionAttemptId": {
                      "type": "string",
                      "description": "首个解析 ActionAttempt ID",
                      "example": "ATT-5f199e47-8f75-4c12-a8f5-bc0f8f3ec401"
                    },
                    "result": {
                      "type": "object",
                      "description": "解析垂直流程结果；详细字段随 canonical Host 页面 fresh projection 读取",
                      "example": {
                        "status": "CANDIDATE_VERTICAL_VERIFIED",
                        "workItem": { "workItemId": "WI-example", "revision": 1 },
                        "authority": {
                          "canonicalRoleSelected": false,
                          "onlineWritePerformed": true,
                          "applicationPublished": false,
                          "currentSelectionChanged": false,
                          "engineeringConclusionCreated": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "请求体、DocumentVersion 或幂等 UUID 无效" },
          "409": { "description": "DocumentVersion 非当前版本或当前解析配置不可用" }
        }
      }
    },
    "/openapi/wiselink/work-items/status": {
      "get": {
        "operationId": "getWorkItemStatus",
        "summary": "读取 WiseLink WorkItem 状态、解析包和候选综合摘要",
        "parameters": [
          {
            "in": "query",
            "name": "workItemId",
            "required": true,
            "schema": { "type": "string" },
            "description": "同一妙搭账本中的 WorkItem ID",
            "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
          }
        ],
        "responses": {
          "200": {
            "description": "返回最新 WorkItem 状态和选定解析包摘要",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "entry",
                    "packageSummary",
                    "assessmentSummary",
                    "integratedAssessmentSummary"
                  ],
                  "properties": {
                    "entry": {
                      "type": "object",
                      "description": "现有 CanonicalEntry fresh-read 投影",
                      "example": {
                        "schemaVersion": "wiselink.3_1.canonical_entry_facade.v0.candidate",
                        "workItemId": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf",
                        "requestId": "REQ-e4ea4706-ece6-4012-b1d5-603bdc0affe9",
                        "phase": "CANDIDATE_READBACK_VERIFIED",
                        "documentVersionId": "document_version_fd88dcb9cf64cf3ba21033ef",
                        "normalizedFamily": "FTD",
                        "packageId": "urn:techpub:package:v1:sha256:9e734a0de1c37c368b954662e9bb11036cc24b430468a073b31da127380df622",
                        "packageArtifactSha256": "349ef64d4538f77aeaf20796deea0e2c5ac2e7cb6d0b4df587570b32d09c56d2",
                        "failureCode": null,
                        "deepLinkPath": "https://example.feishuapp.com/app/app_17bzc551rsg/work-items/WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf/documents",
                        "capabilities": {
                          "status": true,
                          "queryParsedUnits": true,
                          "deepLink": true,
                          "mutatesParsingState": false
                        }
                      }
                    },
                    "packageSummary": {
                      "type": "object",
                      "nullable": true,
                      "description": "选定 frozen.2 解析包摘要；尚无解析包时为 null",
                      "example": {
                        "packageId": "urn:techpub:package:v1:sha256:9e734a0de1c37c368b954662e9bb11036cc24b430468a073b31da127380df622",
                        "contractId": "techpub.parsed-package.v1",
                        "contractRevision": "frozen.2",
                        "artifactSha256": "349ef64d4538f77aeaf20796deea0e2c5ac2e7cb6d0b4df587570b32d09c56d2",
                        "resultStatus": "partial",
                        "title": "777-FTD-31-21002",
                        "contentUnitCount": 311,
                        "sourceRefCount": 239,
                        "readerReceiptId": "reader_receipt_dee9feaf9c3d7accfa6de49d77dcd645",
                        "fullValidationStatus": "FULL_STRICT_VALIDATOR_PASSED"
                      }
                    },
                    "assessmentSummary": {
                      "type": "object",
                      "nullable": true,
                      "description": "同一 WorkItem 的 Job Aid 候选评估薄投影；尚未评估时为 null，且始终不构成工程结论",
                      "example": {
                        "status": "CANDIDATE_ONLY_RESYNTHESIZED",
                        "criterionSetId": "JACS-72D0484B6F1C17A38F671F46",
                        "criterionCount": 150,
                        "evaluationItemCount": 150,
                        "packageStatus": "BLOCKED_MISSING_INPUT",
                        "applicabilityOverall": "待核实",
                        "authorityLevel": "candidate_only",
                        "blocksEngineeringClosure": true,
                        "externalDiscoveryStatus": "ZERO_RESULTS_FOR_TARGET_IDENTIFIER",
                        "externalDiscoveryIsEvidence": false,
                        "previousOverallStale": true,
                        "staleReason": "ENGINEER_ITEM_SET_CHANGED"
                      }
                    },
                    "integratedAssessmentSummary": {
                      "type": "object",
                      "nullable": true,
                      "description": "同一 WorkItem 的 Base 动态 N 规则候选与 OpenClaw candidate_only 整体综合薄投影；旧记录或结果尚未到达时为 null",
                      "example": {
                        "status": "OVERALL_CANDIDATE_STALE",
                        "baseRules": {
                          "status": "CANDIDATE_ONLY",
                          "revision": 2,
                          "sourceResultId": "BASE-RULE-RESULT-737-REV-2",
                          "criterionSetId": "JACS-72D0484B6F1C17A38F671F46",
                          "criterionCount": 150,
                          "evaluationItemCount": 150,
                          "unresolvedCount": 119,
                          "sourceBoundCandidateCount": 25,
                          "artifact": {
                            "storeRole": "UnifiedArtifactStoreCandidate",
                            "ref": "wiselink/integrated-assessment/base-rules/BASE-RULE-RESULT-737-REV-2.json",
                            "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                            "byteLength": 73786,
                            "mediaType": "application/json"
                          },
                          "actionAttemptId": "ATT-BASE-RULE-2"
                        },
                        "overallSynthesis": {
                          "status": "STALE",
                          "revision": 1,
                          "sourceResultId": "OPENCLAW-OVERALL-737-REV-1",
                          "basedOnBaseRuleRevision": 1,
                          "discoveryStatus": "ACCESS_DENIED",
                          "gap": "BOEING:UPSTREAM_CONNECT_TIMEOUT",
                          "candidateRefCount": 0,
                          "findingCount": 1,
                          "unresolvedCount": 119,
                          "authorityLevel": "candidate_only",
                          "externalDiscoveryIsEvidence": false,
                          "artifact": {
                            "storeRole": "UnifiedArtifactStoreCandidate",
                            "ref": "wiselink/integrated-assessment/overall/OPENCLAW-OVERALL-737-REV-1.json",
                            "sha256": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
                            "byteLength": 8192,
                            "mediaType": "application/json"
                          },
                          "actionAttemptId": "ATT-OPENCLAW-OVERALL-1",
                          "staleReason": "BASE_RULE_RESULT_CHANGED"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/wiselink/work-items/parsed-units": {
      "get": {
        "operationId": "querySourceBoundUnits",
        "summary": "查询解析包中带来源引用的内容单元",
        "parameters": [
          {
            "in": "query",
            "name": "workItemId",
            "required": true,
            "schema": { "type": "string" },
            "description": "同一妙搭账本中的 WorkItem ID",
            "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
          },
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "在已验证解析包中执行的只读查询文本",
            "example": "software"
          }
        ],
        "responses": {
          "200": {
            "description": "返回带 sourceRefIds 的内容单元",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "workItemId",
                    "packageId",
                    "query",
                    "resultCount",
                    "results"
                  ],
                  "properties": {
                    "workItemId": {
                      "type": "string",
                      "description": "查询所属 WorkItem",
                      "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
                    },
                    "packageId": {
                      "type": "string",
                      "description": "实际读取的 frozen.2 解析包 ID",
                      "example": "urn:techpub:package:v1:sha256:9e734a0de1c37c368b954662e9bb11036cc24b430468a073b31da127380df622"
                    },
                    "query": {
                      "type": "string",
                      "description": "规范化后的查询文本",
                      "example": "software"
                    },
                    "resultCount": {
                      "type": "integer",
                      "description": "本次返回的内容单元数",
                      "example": 38
                    },
                    "results": {
                      "type": "array",
                      "description": "Unified Reader 返回的来源绑定单元",
                      "items": {
                        "type": "object",
                        "example": {
                          "unitId": "CU-0001",
                          "kind": "software",
                          "text": "Software configuration source text.",
                          "sourceRefIds": ["SR-0001"]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/wiselink/work-items/deep-link": {
      "get": {
        "operationId": "getWorkItemDeepLink",
        "summary": "读取服务端派生的妙搭 WorkItem 深链",
        "parameters": [
          {
            "in": "query",
            "name": "workItemId",
            "required": true,
            "schema": { "type": "string" },
            "description": "同一妙搭账本中的 WorkItem ID",
            "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
          }
        ],
        "responses": {
          "200": {
            "description": "返回该 WorkItem 的 canonical 妙搭页面地址",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["workItemId", "deepLink"],
                  "properties": {
                    "workItemId": {
                      "type": "string",
                      "description": "深链所属 WorkItem",
                      "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
                    },
                    "deepLink": {
                      "type": "string",
                      "format": "uri",
                      "description": "由服务端 canonical app binding 派生的完整 HTTPS 深链",
                      "example": "https://example.feishuapp.com/app/app_17bzc551rsg/work-items/WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf/documents"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/wiselink/mcp": {
      "post": {
        "operationId": "handleWiseLinkMcp",
        "summary": "WiseLink 三项只读能力的无状态 MCP 传输入口",
        "description": "仅承载 MCP initialize、tools/list 与三个只读 tool call；不提供任意 HTTP、资源、提示词、会话或写操作。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "由 MCP SDK 生成并校验的 JSON-RPC 消息",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "202": {
            "description": "MCP 通知已接受"
          },
          "400": {
            "description": "无效 MCP 消息或工具参数"
          }
        }
      }
    },
    "/openapi/wiselink/openclaw-mcp": {
      "post": {
        "operationId": "handleOpenClawMcp",
        "summary": "OpenClaw 专用动态规则候选评估 MCP 入口",
        "description": "独立承载三个查询工具、既有 overall attempt 的只读 resume、OEM discovery 记录及受控 dynamic-N/overall begin/commit；服务端派生 actor、权限、WorkItem revision 和 ActionAttempt，拒绝客户端提供 authority、URL policy override、Header、模型或 agent 身份。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "由 MCP SDK 生成并校验的无状态 JSON-RPC 消息",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "202": {
            "description": "MCP 通知已接受"
          },
          "400": {
            "description": "无效 MCP 消息、未知工具或严格参数校验失败"
          }
        }
      }
    }
  }
}
