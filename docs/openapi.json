{
  "paths": {
    "/openapi/wiselink/development-work-items": {
      "post": {
        "operationId": "createDevelopmentWorkItem",
        "summary": "受控创建 S1 开发验收 WorkItem",
        "description": "仅供受控 DEV/UAT 验收编排调用，不是生产前端功能。网关先完成 API Key transport 认证，Host 再要求显式启用的 service principal/tenant、exact current DocumentVersion 与一次性 developmentRunToken 全量匹配；任一配置缺失或不匹配都在 Catalog/FileService I/O 前 fail closed。请求体不得携带 actor、roles、tenantId、authority 或其他权限字段。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["documentVersionId", "developmentRunToken"],
                "properties": {
                  "documentVersionId": {
                    "type": "string",
                    "description": "要运行的精确且当前的 DocumentVersion ID",
                    "example": "document_version_f4813607b91ee1a20e754e2d"
                  },
                  "developmentRunToken": {
                    "type": "string",
                    "format": "uuid",
                    "description": "本次开发验收运行的一次性幂等 UUID",
                    "example": "0f8fad5b-d9cb-469f-a165-70867728950e"
                  },
                  "query": {
                    "type": "string",
                    "description": "Reader 查询词，省略时由服务端使用默认查询",
                    "example": "applicability"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建或幂等复用开发验收 WorkItem，并返回首个解析 ActionAttempt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schemaVersion",
                    "workItemCreated",
                    "workItemReused",
                    "actionAttemptId",
                    "result"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "type": "string",
                      "description": "运行响应合同版本",
                      "example": "wiselink.3_1.ordinary_work_item_run.v1"
                    },
                    "workItemCreated": {
                      "type": "boolean",
                      "description": "本次是否新建 WorkItem",
                      "example": true
                    },
                    "workItemReused": {
                      "type": "boolean",
                      "description": "本次是否按幂等键复用既有 WorkItem",
                      "example": false
                    },
                    "actionAttemptId": {
                      "type": "string",
                      "description": "首个解析 ActionAttempt ID",
                      "example": "ATT-5f199e47-8f75-4c12-a8f5-bc0f8f3ec401"
                    },
                    "result": {
                      "type": "object",
                      "description": "解析垂直流程结果；详细字段随 canonical Host 页面 fresh projection 读取",
                      "example": {
                        "status": "CANDIDATE_VERTICAL_VERIFIED",
                        "workItem": {
                          "workItemId": "WI-example",
                          "revision": 1
                        },
                        "authority": {
                          "canonicalRoleSelected": false,
                          "onlineWritePerformed": true,
                          "applicationPublished": false,
                          "currentSelectionChanged": false,
                          "engineeringConclusionCreated": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "请求体、DocumentVersion 或幂等 UUID 无效" },
          "409": {
            "description": "DocumentVersion 非当前版本或当前解析配置不可用"
          },
          "503": {
            "description": "受控 DEV/UAT 创建 service scope 未完整配置或未启用"
          }
        }
      }
    },
    "/openapi/wiselink/work-items/status": {
      "get": {
        "operationId": "getWorkItemStatus",
        "summary": "读取 WiseLink WorkItem 状态、解析包和候选综合摘要",
        "description": "仅接受 API Key transport 认证且由 Host 显式配置绑定到 exact tenant + WorkItem 的 service scope；未配置、非 DEV/UAT 或 WorkItem 不匹配时在 I/O 前 fail closed。",
        "parameters": [
          {
            "in": "query",
            "name": "workItemId",
            "required": true,
            "schema": { "type": "string" },
            "description": "同一妙搭账本中的 WorkItem ID",
            "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
          }
        ],
        "responses": {
          "200": {
            "description": "返回最新 WorkItem 状态和选定解析包摘要",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "entry",
                    "packageSummary",
                    "assessmentSummary",
                    "integratedAssessmentSummary",
                    "configurationEvidenceReevaluation"
                  ],
                  "properties": {
                    "entry": {
                      "type": "object",
                      "description": "现有 CanonicalEntry fresh-read 投影",
                      "example": {
                        "schemaVersion": "wiselink.3_1.canonical_entry_facade.v0.candidate",
                        "workItemId": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf",
                        "requestId": "REQ-e4ea4706-ece6-4012-b1d5-603bdc0affe9",
                        "phase": "CANDIDATE_READBACK_VERIFIED",
                        "documentVersionId": "document_version_fd88dcb9cf64cf3ba21033ef",
                        "normalizedFamily": "FTD",
                        "packageId": "urn:techpub:package:v1:sha256:9e734a0de1c37c368b954662e9bb11036cc24b430468a073b31da127380df622",
                        "packageArtifactSha256": "349ef64d4538f77aeaf20796deea0e2c5ac2e7cb6d0b4df587570b32d09c56d2",
                        "failureCode": null,
                        "deepLinkPath": "https://example.feishuapp.com/app/app_17bzc551rsg/work-items/WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf/documents",
                        "capabilities": {
                          "status": true,
                          "queryParsedUnits": true,
                          "deepLink": true,
                          "mutatesParsingState": false
                        }
                      }
                    },
                    "packageSummary": {
                      "type": "object",
                      "nullable": true,
                      "description": "选定 frozen.2 解析包摘要；尚无解析包时为 null",
                      "example": {
                        "packageId": "urn:techpub:package:v1:sha256:9e734a0de1c37c368b954662e9bb11036cc24b430468a073b31da127380df622",
                        "contractId": "techpub.parsed-package.v1",
                        "contractRevision": "frozen.2",
                        "artifactSha256": "349ef64d4538f77aeaf20796deea0e2c5ac2e7cb6d0b4df587570b32d09c56d2",
                        "resultStatus": "partial",
                        "title": "777-FTD-31-21002",
                        "contentUnitCount": 311,
                        "sourceRefCount": 239,
                        "readerReceiptId": "reader_receipt_dee9feaf9c3d7accfa6de49d77dcd645",
                        "fullValidationStatus": "FULL_STRICT_VALIDATOR_PASSED"
                      }
                    },
                    "assessmentSummary": {
                      "type": "object",
                      "nullable": true,
                      "description": "同一 WorkItem 的 Job Aid 候选评估薄投影；尚未评估时为 null，且始终不构成工程结论",
                      "example": {
                        "status": "CANDIDATE_ONLY_RESYNTHESIZED",
                        "criterionSetId": "JACS-72D0484B6F1C17A38F671F46",
                        "criterionCount": 150,
                        "evaluationItemCount": 150,
                        "packageStatus": "BLOCKED_MISSING_INPUT",
                        "applicabilityOverall": "待核实",
                        "authorityLevel": "candidate_only",
                        "blocksEngineeringClosure": true,
                        "externalDiscoveryStatus": "ZERO_RESULTS_FOR_TARGET_IDENTIFIER",
                        "externalDiscoveryIsEvidence": false,
                        "previousOverallStale": true,
                        "staleReason": "ENGINEER_ITEM_SET_CHANGED"
                      }
                    },
                    "integratedAssessmentSummary": {
                      "type": "object",
                      "nullable": true,
                      "description": "同一 WorkItem 的 Base 动态 N 规则候选与 OpenClaw candidate_only 整体综合薄投影；旧记录或结果尚未到达时为 null",
                      "example": {
                        "status": "OVERALL_CANDIDATE_STALE",
                        "baseRules": {
                          "status": "CANDIDATE_ONLY",
                          "revision": 2,
                          "sourceResultId": "BASE-RULE-RESULT-737-REV-2",
                          "criterionSetId": "JACS-72D0484B6F1C17A38F671F46",
                          "criterionCount": 150,
                          "evaluationItemCount": 150,
                          "unresolvedCount": 119,
                          "sourceBoundCandidateCount": 25,
                          "artifact": {
                            "storeRole": "UnifiedArtifactStoreCandidate",
                            "ref": "wiselink/integrated-assessment/base-rules/BASE-RULE-RESULT-737-REV-2.json",
                            "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                            "byteLength": 73786,
                            "mediaType": "application/json"
                          },
                          "actionAttemptId": "ATT-BASE-RULE-2"
                        },
                        "overallSynthesis": {
                          "status": "STALE",
                          "revision": 1,
                          "sourceResultId": "OPENCLAW-OVERALL-737-REV-1",
                          "basedOnBaseRuleRevision": 1,
                          "discoveryStatus": "ACCESS_DENIED",
                          "gap": "BOEING:UPSTREAM_CONNECT_TIMEOUT",
                          "candidateRefCount": 0,
                          "findingCount": 1,
                          "unresolvedCount": 119,
                          "authorityLevel": "candidate_only",
                          "externalDiscoveryIsEvidence": false,
                          "artifact": {
                            "storeRole": "UnifiedArtifactStoreCandidate",
                            "ref": "wiselink/integrated-assessment/overall/OPENCLAW-OVERALL-737-REV-1.json",
                            "sha256": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
                            "byteLength": 8192,
                            "mediaType": "application/json"
                          },
                          "actionAttemptId": "ATT-OPENCLAW-OVERALL-1",
                          "staleReason": "BASE_RULE_RESULT_CHANGED"
                        }
                      }
                    },
                    "configurationEvidenceReevaluation": {
                      "type": "object",
                      "nullable": true,
                      "description": "配置证据采纳触发的全量重算只读进度；不暴露内部 attempt、staged bundle 或权限信息，尚未触发时为 null",
                      "example": {
                        "schemaVersion": "wiselink.3_1.configuration_evidence_reevaluation_status.v1",
                        "triggerSnapshotId": "CONFIGURATION-SNAPSHOT:REQ-AIMS2-TRUE",
                        "triggerConfigurationRevision": 2,
                        "mode": "FULL_APPLICABILITY_JOB_AID_OVERALL",
                        "status": "RUNNING",
                        "nextStage": "JOB_AID",
                        "stages": {
                          "applicability": {
                            "status": "SUCCEEDED",
                            "retryNo": 0
                          },
                          "jobAid": { "status": "PENDING", "retryNo": 0 },
                          "overall": { "status": "PENDING", "retryNo": 0 }
                        },
                        "servingCurrentPreserved": true,
                        "candidateOnly": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "网关尚未提供可验证的 exact WorkItem service scope"
          }
        }
      }
    },
    "/openapi/wiselink/work-items/parsed-units": {
      "get": {
        "operationId": "querySourceBoundUnits",
        "summary": "查询解析包中带来源引用的内容单元",
        "description": "仅接受 API Key transport 认证且由 Host 显式配置绑定到 exact tenant + WorkItem 的 service scope；未配置、非 DEV/UAT 或 WorkItem 不匹配时在 package artifact/content I/O 前 fail closed。",
        "parameters": [
          {
            "in": "query",
            "name": "workItemId",
            "required": true,
            "schema": { "type": "string" },
            "description": "同一妙搭账本中的 WorkItem ID",
            "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
          },
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "在已验证解析包中执行的只读查询文本",
            "example": "software"
          }
        ],
        "responses": {
          "200": {
            "description": "返回带 sourceRefIds 的内容单元",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "workItemId",
                    "packageId",
                    "query",
                    "resultCount",
                    "results"
                  ],
                  "properties": {
                    "workItemId": {
                      "type": "string",
                      "description": "查询所属 WorkItem",
                      "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
                    },
                    "packageId": {
                      "type": "string",
                      "description": "实际读取的 frozen.2 解析包 ID",
                      "example": "urn:techpub:package:v1:sha256:9e734a0de1c37c368b954662e9bb11036cc24b430468a073b31da127380df622"
                    },
                    "query": {
                      "type": "string",
                      "description": "规范化后的查询文本",
                      "example": "software"
                    },
                    "resultCount": {
                      "type": "integer",
                      "description": "本次返回的内容单元数",
                      "example": 38
                    },
                    "results": {
                      "type": "array",
                      "description": "Unified Reader 返回的来源绑定单元",
                      "items": {
                        "type": "object",
                        "example": {
                          "unitId": "CU-0001",
                          "kind": "software",
                          "text": "Software configuration source text.",
                          "sourceRefIds": ["SR-0001"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "网关尚未提供可验证的 exact WorkItem service scope"
          }
        }
      }
    },
    "/openapi/wiselink/work-items/deep-link": {
      "get": {
        "operationId": "getWorkItemDeepLink",
        "summary": "读取服务端派生的妙搭 WorkItem 深链",
        "description": "仅接受 API Key transport 认证且由 Host 显式配置绑定到 exact tenant + WorkItem 的 service scope；未配置、非 DEV/UAT 或 WorkItem 不匹配时在 WorkItem I/O 前 fail closed。",
        "parameters": [
          {
            "in": "query",
            "name": "workItemId",
            "required": true,
            "schema": { "type": "string" },
            "description": "同一妙搭账本中的 WorkItem ID",
            "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
          }
        ],
        "responses": {
          "200": {
            "description": "返回该 WorkItem 的 canonical 妙搭页面地址",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["workItemId", "deepLink"],
                  "properties": {
                    "workItemId": {
                      "type": "string",
                      "description": "深链所属 WorkItem",
                      "example": "WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf"
                    },
                    "deepLink": {
                      "type": "string",
                      "format": "uri",
                      "description": "由服务端 canonical app binding 派生的完整 HTTPS 深链",
                      "example": "https://example.feishuapp.com/app/app_17bzc551rsg/work-items/WI-c2943f5a-d023-46ac-9cf5-9480de0aabaf/documents"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "网关尚未提供可验证的 exact WorkItem service scope"
          }
        }
      }
    },
    "/openapi/wiselink/mcp": {
      "post": {
        "operationId": "handleWiseLinkMcp",
        "summary": "WiseLink 三项只读能力的无状态 MCP 传输入口",
        "description": "仅承载 MCP initialize、tools/list 与三个只读 tool call；每个工具都必须通过 API Key transport 并绑定 Host 显式配置的 exact tenant + WorkItem service scope，缺失或不匹配时在 MCP 业务 I/O 前 fail closed。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "由 MCP SDK 生成并校验的 JSON-RPC 消息",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "202": {
            "description": "MCP 通知已接受"
          },
          "400": {
            "description": "无效 MCP 消息或工具参数"
          },
          "503": {
            "description": "网关尚未提供可验证的 MCP service/WorkItem scope"
          }
        }
      }
    },
    "/openapi/wiselink/openclaw-mcp": {
      "post": {
        "operationId": "handleOpenClawMcp",
        "summary": "OpenClaw 专用 ActionAttempt 队列与候选评估 MCP 入口",
        "x-wiselink-common-context": {
          "location": "JobAid / Overall modelInput.commonContext；Review modelInput.context.commonContext",
          "behavior": "评估前复用主文件章节、当前身份可见的关联背景片段与普通讨论，存入现有 Task 输入。关联资料仍是 BACKGROUND_ONLY；施工引用默认只入目录。最近 12 个历史回合按顺序传入并报告省略数，旧 revision 的工作回答单独标记，不冒充正式采用。RAG 尚未连接时明确 NOT_CONNECTED。",
          "compatibility": "可选背景扩展由 Skill r09.c20 识别；旧任务无字段时保持原输入。MCP 工具参数、TaskEnvelope、候选结果和正式采用入口不变。"
        },
        "x-wiselink-review-execution": {
          "pendingTool": "get_pending_review_turn",
          "input": { "workItemId": "Host 已授权的 exact WorkItem" },
          "behavior": "只读按保存顺序查询 ACTIVE 会话中显式 AUTOMATIC 的 Turn；未领取返回 next 引用，当前租约有效返回 busy，不自动重放历史普通保存或已完成的 Turn。begin_review_turn 在准备上下文前持久化既有 ActionAttempt，使准备失败可从页面回读。候选回写不确认 ReviewAction，不修改 WorkItem revision/current/STALE。",
          "browserReadback": "ReviewTurn.execution 返回 REQUESTED、QUEUED、RUNNING、COMMITTING 及实际终态、时间和错误；没有执行记录时为 null，不推断模型运行状态。ReviewConversation.automaticExecutionAvailable 按既有 executor 的 tenant/WorkItem 配置范围返回；不是实时健康状态。前端只在 true 时为新提交附 AUTOMATIC，其他范围保留普通保存；范围外的显式 AUTOMATIC 请求返回 503 REVIEW_AUTOMATIC_EXECUTION_UNAVAILABLE。"
        },
        "x-wiselink-review-native-session": {
          "location": "begin_review_turn result.nativeSessionKey（可选控制面字段，不进入模型或浏览器 DTO）",
          "behavior": "Host 根据已有上一条 Turn 的成功 ActionAttempt 和本轮 fresh 授权 SourceRef 目录决定是否延续会话；相同会话、revision、来源 ID 及 artifact 版本才复用已保存的 actorContextRef。首次、旧版本任务、上一轮失败或资料范围变化时使用当前 Turn 主键派生新引用，不新增表或 hash。",
          "compatibility": "Skill r09.c22 将该值仅作为匹配 wiselink-engineering 的 Gateway session header；旧 Host 无字段时明确报告 TURN_ISOLATED_LEGACY_HOST。原 Task/Result/MCP 参数、实际读取和单次候选提交规则不变。"
        },
        "description": "承载 translation、applicability、dynamic-N 与 overall 的 PostgreSQL QUEUED→lease claim→RUNNING→完整 ResultEnvelope→COMMITTING→Host CAS 链路，并提供 heartbeat/cancel。普通单项流程保持既有 current 行为；配置证据采纳触发的 P0B 全量重算只把 Applicability 与 Dynamic 候选写入 Host staged bundle，由 Overall 基于 shadow 复核后一次 CAS 同时提升全部 serving current，任一中间失败都保留旧 serving current。TaskEnvelope 由 Host 密封；translation begin 通过同一工具按实际序列化 UTF-8 bytes 返回完整 MCP tool result 不超过 14,000 bytes 的可读 SourceUnit 批次，避免托管工具输出截断且不重复返回 modelInput，不暴露 tenant 或 FileService locator。RUNNING 默认使用 30 分钟 lease/60 分钟 deadline，Skill 在模型前后受控 heartbeat，模型生成期间不依赖短周期回调。重复 begin 遇到 COMMITTING 时返回 DB 中重新校验 hash/binding 的 recovery ResultEnvelope，executor 只重放 Host commit、不二次调用模型。损坏、缺字段或 hash/binding 不一致的 ResultEnvelope 不会被替换为 {}。仅当 API Key transport、service principal、tenant 与 exact WorkItem/ActionAttempt allowlist 全部可验证时处理业务 I/O；未配置时 fail closed。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "由 MCP SDK 生成并校验的无状态 JSON-RPC 消息",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "202": {
            "description": "MCP 通知已接受"
          },
          "400": {
            "description": "无效 MCP 消息、未知工具或严格参数校验失败"
          },
          "409": {
            "description": "lease fencing、取消截止、ResultEnvelope 绑定或 WorkItem CAS 冲突"
          },
          "503": {
            "description": "未配置可验证的 OpenClaw service/object scope、专用 executor 不可用，或同 tenant 的四个执行槽均被占用"
          }
        }
      }
    }
  }
}
